{
  "name": "sunbird-ed-discussions-ui-v8",
  "version": "4.0.1",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "test": "jest",
    "test:ci": "jest --silent --ci --w 2 --collectCoverage=true --coverageReporters=lcov",
    "lint": "ng lint",
    "e2e": "ng e2e",
    "copy:assets": "cp -r ./projects/discussion-ui/assets dist/discussion-ui/",
    "build-lib": "ng build && npm run copy:assets"
  },
  "dependencies": {
    "@angular/animations": "^17.3.12",
    "@angular/common": "^17.3.12",
    "@angular/compiler": "^17.3.12",
    "@angular/core": "^17.3.12",
    "@angular/forms": "^17.3.12",
    "@angular/platform-browser": "^17.3.12",
    "@angular/platform-browser-dynamic": "^17.3.12",
    "@angular/router": "^17.3.12",
    "copyfiles": "^2.4.1",
    "core-js": "^2.5.4",
    "dayjs": "^1.10.4",
    "ngx-infinite-scroll": "^17.0.1",
    "rxjs": "~6.6.7",
    "tslib": "^2.0.0",
    "zone.js": "~0.14.10"
  },
  "resolutions": {
    "source-map": "0.7.4"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^17.3.17",
    "@angular/cli": "^17.3.17",
    "@angular/compiler-cli": "^17.3.12",
    "@angular/language-service": "^17.3.12",
    "@project-sunbird/client-services": "^3.9.5",
    "@types/jasmine": "~2.8.8",
    "@types/jasminewd2": "~2.0.3",
    "@types/jest": "^26.0.22",
    "@types/node": "~8.9.4",
    "codelyzer": "^6.0.0",
    "jasmine-core": "~3.10",
    "jasmine-spec-reporter": "~7.0",
    "jest": "^29.7.0",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.1.0",
    "karma-coverage-istanbul-reporter": "~3.0.2",
    "karma-jasmine": "~4.0.0",
    "karma-jasmine-html-reporter": "^1.7.0",
    "lodash-es": "^4.17.20",
    "ng-packagr": "^17.3.0",
    "ngx-chips": "3.0.0",
    "protractor": "~7.0.0",
    "ts-jest": "^29.0.0",
    "ts-node": "~7.0.0",
    "tslint": "~6.1.0",
    "typescript": "^5.4.5"
  },
  "description": "Sunbird discussions ui library",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sunbird-Ed/discussions-UI.git"
  },
  "keywords": [
    "sunbird",
    "discussion",
    "angular"
  ],
  "author": "Vinu Kumar",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Sunbird-Ed/discussions-UI/issues"
  },
  "homepage": "https://github.com/Sunbird-Ed/discussions-UI#readme",
  "jest": {
    "globals": {
      "ts-jest": {
        "tsConfig": "<rootDir>/projects/discussion-ui/tsconfig.spec.json"
      }
    },
    "browser": false,
    "rootDir": "./",
    "roots": [
      "<rootDir>/projects/discussion-ui/src/"
    ],
    "moduleDirectories": [
      "node_modules"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/"
    ],
    "coveragePathIgnorePatterns": [],
    "testMatch": [
      "**/?(*.)(spec).ts"
    ],
    "restoreMocks": true,
    "moduleFileExtensions": [
      "js",
      "jsx",
      "json",
      "ts",
      "tsx"
    ],
    "setupFiles": [],
    "transform": {
      "^.+\\.(ts)$": "ts-jest"
    },
    "coverageReporters": [
      "text",
      "json"
    ],
    "transformIgnorePatterns": []
  }
}